extends SceneTree
const Solver = preload("res://scripts/hold_solver.gd")
const Device = preload("res://scripts/handheld.gd")
const Router = preload("res://scripts/input_router.gd")
const InProcessBackend = preload("res://scripts/azahar_in_process_backend.gd")
const Cartridge = preload("res://scripts/game_cartridge.gd")
const CartridgeSlot = preload("res://scripts/cartridge_slot.gd")
const CartridgeLibrary = preload("res://scripts/cartridge_library.gd")
const CaseInteraction = preload("res://scripts/case_interaction.gd")
const GameCase = preload("res://scripts/game_case.gd")
var failures := 0
var assertions := 0
func check(value: bool, label: String) -> void:
 assertions += 1
 if not value:
  failures += 1
  push_error("FAIL: " + label)
func _initialize() -> void:
 var left := Transform3D(Basis.IDENTITY, Vector3(-0.09, 1, 0))
 var right := Transform3D(Basis.IDENTITY, Vector3(0.09, 1, 0))
 var solver := Solver.new()
 solver.step(1, left, right, true, false, false)
 check(solver.state == Solver.State.DOCKED, "Proximity alone does not bypass grip confirmation")
 solver.step(0.2, left, right, true, true, false)
 check(solver.state == Solver.State.CANDIDATE, "Short gesture is only a candidate")
 solver.step(0.3, left, right, true, true, false)
 check(solver.state == Solver.State.HELD, "Sustained valid gesture picks up")
 right.origin.x = 0.4
 solver.step(0.1, left, right, true, false, false)
 check(solver.state == Solver.State.HELD, "Hand separation and grip release do not drop device")
 var missing: Dictionary = solver.step(2, left, right, false, false, false)
 check(solver.state == Solver.State.HELD and not missing.valid, "Tracking loss freezes held pose")
 solver.step(0.1, left, right, true, true, true)
 check(solver.state == Solver.State.DOCKED, "Explicit release docks")
 right.origin.x = 0.09
 solver.require_grips = false
 solver.step(0.2, left, right, true, false, false)
 solver.step(0.1, left, right, false, false, false)
 solver.step(0.3, left, right, true, false, false)
 check(solver.state == Solver.State.CANDIDATE, "Tracking interruption resets pickup dwell")
 solver.reset()
 solver.step(1, right, left, true, true, false)
 check(solver.state == Solver.State.HELD, "Reversed controller orientation does not reject pickup")
 var fallback := Basis.from_euler(Vector3(0.2, 0.3, 0.4))
 check(Solver.solve_basis(left, left, fallback).is_equal_approx(fallback), "Coincident hands preserve orientation")
 var solved := Solver.solve_basis(left, right, fallback)
 check(is_equal_approx(solved.determinant(), 1), "Held orientation is right-handed and orthonormal")
 check(solved.is_equal_approx(Basis.IDENTITY), "Aligned hands preserve expected axes")
 var size := Vector2(0.08, 0.06)
 var identity := Transform3D.IDENTITY
 check(Device.surface_uv(identity, size, Vector3(0, 1, 0), Vector3.DOWN).is_equal_approx(Vector2(0.5, 0.5)), "Touch center")
 check(Device.surface_uv(identity, size, Vector3(-0.039, 1, -0.029), Vector3.DOWN).distance_to(Vector2(0.0125, 0.016667)) < 0.001, "Touch upper left")
 check(Device.surface_uv(identity, size, Vector3(1, 1, 0), Vector3.DOWN).x < 0, "Touch outside screen rejected")
 check(Device.surface_uv(identity, size, Vector3(0, -1, 0), Vector3.UP).x < 0, "Back-face touch rejected")
 var transformed := Transform3D(Basis.from_euler(Vector3(0.5, 0.2, 0)).scaled(Vector3.ONE * 1.7), Vector3(0.4, 1.2, -0.5))
 check(Device.surface_uv(transformed, size, transformed * Vector3(0, 1, 0), transformed.basis * Vector3.DOWN).is_equal_approx(Vector2(0.5, 0.5)), "Touch after scale and rotation")
 var router := Router.new()
 var events: Array = []
 router.button_changed.connect(func(key, down): events.append([key, down]))
 router.update({"A": true}, Vector2(1, 0))
 router.update({"A": true}, Vector2(1, 0))
 check(events.size() == 1, "Held input emits only one down event")
 router.release_all()
 check(events.size() == 2 and events[1] == ["A", false], "Focus/tracking recovery can release all inputs")
 var in_process := InProcessBackend.new()
 in_process.set_enabled(true)
 check(not in_process.connected and in_process.enabled, "Integrated backend stays offline until its core produces a frame")
 check(in_process.message.begins_with("Integrated runtime available"), "Integrated backend detects the native extension")
 in_process.free()
 var slot := CartridgeSlot.new()
 var cartridge := Cartridge.new()
 cartridge.configure("example", "Example cartridge", "C:/Games/example.cci")
 check(slot.insert(cartridge), "Empty rear slot accepts a cartridge")
 check(slot.has_game() and cartridge.inserted, "Inserted cartridge retains its selected game path")
 check(not slot.insert(cartridge), "Occupied rear slot rejects duplicate insertion")
 check(slot.eject() == cartridge and not cartridge.inserted, "Eject returns the physical cartridge")
 slot.free()
 cartridge.free()
 var library := CartridgeLibrary.new()
 library.register_game("test", "Test Game", "C:/Games/test.cci")
 var spawned = library.spawn_cartridge("test")
 check(spawned != null and spawned.content_path.ends_with("test.cci"), "Curated library spawns a selected cartridge without scanning disks")
 check(library.spawn_cartridge("missing") == null, "Library does not invent unregistered games")
 spawned.free()
 var interaction_card := Cartridge.new()
 interaction_card.configure("interaction", "Interaction cartridge", "C:/Games/interaction.cci")
 interaction_card.build_visual()
 var interaction_case := GameCase.new()
 interaction_case.configure(interaction_card)
 var interaction_slot := CartridgeSlot.new()
 interaction_slot.position = Vector3(0.02, 0, -0.05)
 var interaction := CaseInteraction.new()
 interaction.configure(interaction_case, interaction_slot)
 check(interaction.open_case() and interaction.take_card() == interaction_card, "Opening a case makes its card available to grab")
 var near_slot := Transform3D(Basis.IDENTITY, interaction_slot.position + Vector3(0, -0.001, -0.010))
 check(interaction.release_card(near_slot) and interaction.state == interaction.State.INSERTED, "Aligned held card snaps into rear slot")
 interaction_case.free()
 interaction_slot.free()
 var map: OpenXRActionMap = load("res://openxr_action_map.tres")
 var frame := map.find_interaction_profile("/interaction_profiles/valve/frame_controller_valve")
 check(frame != null and frame.bindings.size() == 28, "Explicit Frame bindings exist")
 var physical: Dictionary = {}
 if frame:
  for binding in frame.bindings:
   check(not physical.has(binding.binding_path), "No duplicate binding for " + binding.binding_path)
   physical[binding.binding_path] = true
 print("RESULT: ", assertions, " assertions, ", failures, " failures")
 quit(0 if failures == 0 else 1)
